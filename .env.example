# SGCS Frontend Environment Variables

# Production Backend Base URL (Spring Boot on Render)
VITE_API_BASE_URL=https://smart-governance-and-civic-corporation.onrender.com

# Firebase Client Web SDK Configuration (Used for browser FCM push notifications)
# Obtain these values from Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sgcs-civic-system
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
