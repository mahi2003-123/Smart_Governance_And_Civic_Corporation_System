# SGCS Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# For Vercel production deployments, set these in the Vercel project dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Backend base URL — point to your Render backend service
# Local dev default (used when this var is absent on localhost):
#   http://localhost:5000
# Production (set in Vercel dashboard):
#   https://sgcs-backend.onrender.com
VITE_API_BASE_URL=https://sgcs-backend.onrender.com

# [OPTIONAL] Firebase Client Web SDK Configuration
# Only needed if push notifications are enabled (firebase.enabled=true on backend).
# Obtain from Firebase Console > Project Settings > General > Your apps (Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sgcs-civic-system
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
